    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Photos Curator needs access to your photo library to analyze and select your best photos. Photo analysis is performed on your device."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos Curator cần quyền truy cập thư viện ảnh để phân tích và chọn những ảnh đẹp nhất. Phân tích ảnh được thực hiện trên thiết bị của bạn."
          }
        }
      }
    }
